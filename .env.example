# ============================================
# Application Environment & Server
# ============================================
APP_PORT=8080
SPRING_PROFILES_ACTIVE=prod
FRONTEND_URL=https://app.gymmatehub.com

# ============================================
# Security & JWT Configuration
# ============================================
# Generate a strong 256-bit+ base64 key
JWT_SECRET=gymmate_jwt_secret_key_change_me_to_at_least_32_bytes_long_123456
JWT_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# CORS Configuration (Comma-separated list of allowed web origins)
CORS_ALLOWED_ORIGINS=https://gymmatehub.com,https://app.gymmatehub.com,https://admin.gymmatehub.com
CORS_ALLOW_CREDENTIALS=true

# Initial Admin Credentials
APP_ADMIN_EMAIL=admin@gymmatehub.com
APP_ADMIN_PASSWORD=YourSecureAdminPassword123!
APP_ADMIN_FIRST_NAME=System
APP_ADMIN_LAST_NAME=Admin

# ============================================
# Database Configuration (PostgreSQL)
# ============================================
PG_URI=jdbc:postgresql://localhost:5432/gymmate
DB_DRIVER=org.postgresql.Driver
DB_DIALECT=org.hibernate.dialect.PostgreSQLDialect
PG_USER=gymmate_user
PG_PASSWORD=your_db_password

# JPA & Migration Configuration
JPA_DDL_AUTO=validate
FLYWAY_ENABLED=true
SHOW_SQL=false

# ============================================
# Redis Configuration (Distributed Caching & Sessions)
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# ============================================
# Email / Mailtrap Live SMTP Configuration
# ============================================
MAIL_HOST=live.smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=api
MAIL_PASSWORD=your_mailtrap_live_api_token
MAIL_FROM=noreply@gymmatehub.com

# Optional Whitelabel Credential Encryption Key
APP_WHITELABEL_ENCRYPTION_KEY=GymMateWhitelabelEncryptionKey2026!

# ============================================
# Stripe Payment Gateway Configuration
# ============================================
STRIPE_API_KEY=sk_live_your_stripe_api_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_your_connect_webhook_secret
STRIPE_APPLICATION_FEE_PERCENT=1.0

# ============================================
# AI & External Services
# ============================================
SPRING_AI_OPENAI_API_KEY=sk-your_openai_api_key
AI_PLAN_CACHE_TTL_HOURS=24

# ============================================
# Logging & File Storage
# ============================================
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_GYMMATE=INFO
FILE_UPLOAD_DIR=./uploads

